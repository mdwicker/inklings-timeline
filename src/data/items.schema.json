{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "maximum": 9999
      },
      "group": {
        "type": "integer",
        "maximum": 9999
      },
      "category": {
        "type": "string"
      },
      "name": {
        "type": "string",
        "maxLength": 100
      },
      "description": {
        "type": "string"
      },
      "start": {
        "type": "string",
        "pattern": "^((1[89][0-9]{2})|(2[0-9]{3}))-((0[1-9])|(1[012]))-(([0-2][0-9])|(3[01]))$"
      },
      "end": {
        "type": "string",
        "pattern": "^((1[89][0-9]{2})|(2[0-9]{3}))-((0[1-9])|(1[012]))-(([0-2][0-9])|(3[01]))$"
      },
      "edtf": {
        "type": "string"
      },
      "priority": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
      },
      "note": {
        "type": "string"
      }
    },
    "required": ["id", "group", "category", "name", "start", "edtf", "priority"]
  }
}
