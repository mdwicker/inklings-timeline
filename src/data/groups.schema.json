{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "maximum": 200
      },
      "name": {
        "type": "string",
        "maxLength": 50
      }
    },
    "required": ["id", "name"]
  }
}
